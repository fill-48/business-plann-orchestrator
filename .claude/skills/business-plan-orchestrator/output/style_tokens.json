  "promotion_lexicon": {
    "description": "LESSICO CHIUSO di promozione, applicato alla PROSA GENERATA del capitolo (non alle stringhe copiate VERBATIM dal canonico, che sono citazioni). Ogni voce dichiara la condizione canonica sotto cui il termine è ammesso: fuori da quella condizione il termine è un difetto, rilevato dai test del capitolo con attribuzione di sezione e termine. Il controllo fallisce ANCHE se ogni numero è corretto: misura la RAPPRESENTAZIONE, non l'esito.",
    "scan_scope": "La scansione si applica alle sole righe di PROSA GENERATA: sono ESCLUSE le righe di tabella (che iniziano con `|` e portano valori e stringhe canoniche) e le CITAZIONI VERBATIM del canonico, delimitate dalle virgolette caporali `«` e `»`. La convenzione è DICHIARATA e verificabile: ciò che sta fra caporali è una citazione del canonico, non un'affermazione del capitolo.",
    "verbatim_citation_delimiters": ["«", "»"],
    "terms": [
      {"term": "investor-ready", "forms": ["investor-ready", "investor ready"], "allowed_when": "investor_readiness_ready"},
      {"term": "pronto per l'investitore", "forms": ["pronto per l'investitore", "pronta per l'investitore"], "allowed_when": "investor_readiness_ready"},
      {"term": "bancabile", "forms": ["bancabile", "bancabili"], "allowed_when": "investor_readiness_ready"},
      {"term": "presentabile", "forms": ["presentabile", "presentabili"], "allowed_when": "investor_readiness_ready"},
      {"term": "confermato", "forms": ["confermato", "confermata", "confermati", "confermate"], "allowed_when": "all_drivers_confirmed"},
      {"term": "validato", "forms": ["validato", "validata", "validati", "validate"], "allowed_when": "all_drivers_confirmed"},
      {"term": "verificato", "forms": ["verificato", "verificata", "verificati", "verificate"], "allowed_when": "all_drivers_confirmed"},
      {"term": "solido", "forms": ["solido", "solida", "solidi", "solide"], "allowed_when": "all_drivers_confirmed"},
      {"term": "testato", "forms": ["testato", "testata", "testati", "testate"], "allowed_when": "all_scenarios_produced"},
      {"term": "stressato", "forms": ["stressato", "stressata", "stressati", "stressate"], "allowed_when": "all_scenarios_produced"},
      {"term": "non rilevante", "forms": ["non rilevante", "non rilevanti"], "allowed_when": "never"}
    ],
    "predicates": {
      "investor_readiness_ready": "financial_plan.validation.investor_readiness.status == \"ready\"",
      "all_drivers_confirmed": "ogni driver_entry.status == \"confirmed\"",
      "all_scenarios_produced": "financial_plan.results.scenarios.coverage.level == \"full\"",
      "never": "mai ammesso: un KPI NOT_APPLICABLE è «non calcolabile per assenza del driver X», mai «non rilevante»"
    }
  },
