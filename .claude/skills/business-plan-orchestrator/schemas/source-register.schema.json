{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Register",
  "description": "Fonti citate nel piano (reference/architecture.md §12.4). Vive in shared/source-register.json.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "source_type"],
    "properties": {
      "id": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" },
      "title": { "type": "string" },
      "publisher": { "type": "string" },
      "url_or_path": { "type": "string" },
      "publication_date": { "type": "string" },
      "access_date": { "type": "string" },
      "source_type": {
        "type": "string",
        "enum": ["official", "industry_report", "academic", "news", "company",
                 "interview", "internal", "estimate", "other"]
      },
      "quality_rating": { "type": "string", "enum": ["low", "medium", "high"] },
      "used_for": { "type": "array", "items": { "type": "string" } },
      "notes": { "type": "string" }
    }
  }
}
